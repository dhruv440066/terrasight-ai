# CleanPath AI / TerraSight AI — Backend Environment Configuration
# Copy this file to .env and adjust values as needed.

# Database connection URL (SQLite local default; PostgreSQL also supported)
DATABASE_URL=sqlite:///./cleanpath.db

# JWT Authentication Secret Key
SECRET_KEY=cleanpath-ai-terrasight-municipal-jwt-secret-key-2026

# YOLOv8 Model Weights Path & Confidence Threshold
MODEL_PATH=models/best.pt
CONFIDENCE_THRESHOLD=0.25

# Image Uploads Directory
UPLOAD_DIR=uploads

# DBSCAN Geospatial Clustering Parameters
CLUSTER_RADIUS_METERS=50
MIN_CLUSTER_SAMPLES=1

# Default Municipal Center (New Delhi, India)
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.2090

# Demo Mode (false = Production mode, only real citizen reports in database;
#            true  = Seed 15 realistic New Delhi demo incidents on startup)
DEMO_MODE=false
