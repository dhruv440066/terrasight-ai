# ==============================================================================
# TerraSight AI — Environment Configuration Template
# ==============================================================================

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./cleanpath.db
# Render / Production PostgreSQL:
# DATABASE_URL=postgresql://username:password@hostname:5432/dbname

# JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Computer Vision & Machine Learning Model
MODEL_PATH=models/best.pt
FALLBACK_MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.20
IOU_THRESHOLD=0.45

# Geospatial DBSCAN Clustering
HOTSPOT_RADIUS_METERS=50.0

# CORS Allowed Origins (Comma-separated)
# For local development:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# For Render deployment:
# CORS_ORIGINS=https://terrasight-frontend.onrender.com,https://terrasight-ai.onrender.com

# Server & Runtime Settings
PORT=8000
DEMO_MODE=false
UPLOAD_DIR=uploads

# Frontend API URL (for frontend/.env)
# VITE_API_URL=https://terrasight-api.onrender.com
