{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm install --include=dev",
      "buildCommand": "npx vite build",
      "outputDirectory": "dist"
    },
    "api": {
      "root": "api",
      "framework": "fastapi",
      "entrypoint": "index:app",
      "buildCommand": "python --version"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/api", "destination": { "service": "api" } },
    { "source": "/health", "destination": { "service": "api" } },
    { "source": "/reverse-geocode", "destination": { "service": "api" } },
    { "source": "/auth/(.*)", "destination": { "service": "api" } },
    { "source": "/uploads/(.*)", "destination": { "service": "api" } },
    { "source": "/docs", "destination": { "service": "api" } },
    { "source": "/redoc", "destination": { "service": "api" } },
    { "source": "/openapi.json", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
